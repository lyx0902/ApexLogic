# DeepSeek (OpenAI compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Tavily
TAVILY_API_KEY=your_tavily_api_key

# Search providers
SEARCH_QUERY_BUDGET=3
DDG_RESULTS_PER_QUERY=10
ARXIV_RESULTS_PER_QUERY=5
TAVILY_RESULTS_PER_QUERY=3

# Runtime
MAX_REVISIONS=3

# Source filtering (Researcher)
MIN_SOURCE_QUALITY=0.66
MIN_SOURCE_SIGNAL=0.52
MIN_SOURCE_RELEVANCE=0.22
MIN_SOURCE_COMPOSITE=0.58
MIN_CONTEXT_KEEP=6
FILTER_WEIGHT_QUALITY=0.55
FILTER_WEIGHT_SIGNAL=0.15
FILTER_WEIGHT_RELEVANCE=0.30
REQUIRED_SOURCE_DIVERSITY=duckduckgo,arxiv,tavily

