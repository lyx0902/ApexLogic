# DeepSeek (OpenAI compatible)
# Optional local persistence paths (defaults: project data/ and appstats/)
# APEXLOGIC_DATA_DIR=D:/PycharmProjects/ApexLogic/data
# APEXLOGIC_HISTORY_DIR=D:/PycharmProjects/ApexLogic/appstats
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Tavily
TAVILY_API_KEY=your_tavily_api_key

# Search providers
SEARCH_QUERY_BUDGET=3
DDG_TOTAL_RESULTS=45
ARXIV_TOTAL_RESULTS=10
TAVILY_TOTAL_RESULTS=5
ARXIV_SYNONYM_FILE=

# Broad search execution limits (runtime controls; do not change saved search budgets)
APEXLOGIC_BROAD_MAX_WORKERS=4
APEXLOGIC_BROAD_DDG_MAX_INFLIGHT=2
APEXLOGIC_BROAD_ARXIV_MAX_INFLIGHT=1
APEXLOGIC_BROAD_TAVILY_MAX_INFLIGHT=1
APEXLOGIC_GRAPH_MAX_WORKERS=2
APEXLOGIC_AQD_MAX_WORKERS=2
APEXLOGIC_IRCOT_MAX_WORKERS=2

# Shared PostgreSQL Worker/provider permits; configure identically on all Workers
APEXLOGIC_GLOBAL_RESEARCH_MAX_INFLIGHT=2
APEXLOGIC_GLOBAL_DDG_MAX_INFLIGHT=4
APEXLOGIC_GLOBAL_ARXIV_MAX_INFLIGHT=2
APEXLOGIC_GLOBAL_TAVILY_MAX_INFLIGHT=2
APEXLOGIC_GLOBAL_DDG_PER_MINUTE=60
APEXLOGIC_GLOBAL_ARXIV_PER_MINUTE=20
APEXLOGIC_GLOBAL_TAVILY_PER_MINUTE=60
APEXLOGIC_PROVIDER_WAIT_SECONDS=30
APEXLOGIC_QUEUE_MAX_PENDING=100

# BGE retrieval pipeline (OpenAI-compatible API)
BGE_RETRIEVER_ENABLED=1
BGE_RERANKER_ENABLED=1
BGE_RETRIEVER_TOP_K=20
BGE_RERANKER_TOP_K=10

# 推荐使用 SiliconFlow 等兼容 /v1/embeddings 与 /v1/rerank 的服务
# 也可替换为你自建网关，只需保持 OpenAI 兼容协议
BGE_EMBED_API_KEY=your_bge_api_key
BGE_EMBED_BASE_URL=https://api.siliconflow.cn/v1
BGE_EMBED_MODEL=BAAI/bge-m3
BGE_EMBED_TIMEOUT=20
BGE_EMBED_BATCH_SIZE=32

BGE_RERANK_API_KEY=your_bge_api_key
BGE_RERANK_BASE_URL=https://api.siliconflow.cn/v1
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_RERANK_TIMEOUT=25

# Runtime
MAX_REVISIONS=4
REVIEWER_PASS_THRESHOLD=7.5
# 降级评审（LLM 失败/输出无法解析）是否允许放行；默认 0 表示降级只应更保守
REVIEWER_ALLOW_DEGRADED_PASS=0

# Optimization: MAB + Graph Expand
GRAPH_EXPAND_QUERIES=4

# Optimization: IRCoT Iterative Retrieval (方案1)
ITERATIVE_RETRIEVAL_ENABLED=1   # 设为 0 可完全禁用
MAX_HOPS=4                      # 最大推理跳数（建议 2~3）
GAP_QUERIES_PER_HOP=2           # 每跳发出的补充查询数
GAP_RESULTS_PER_QUERY=3         # 每条补充查询的 DDG 结果数

# Optimization: Adaptive Query Decomposition (方案2)
AQD_ENABLED=1                   # 设为 0 可完全禁用
AQD_MAX_SUB_QUESTIONS=4         # 最大子问题数量（建议 3~5）
AQD_RESULTS_PER_SUBQ=3          # 每个子问题的 DDG 检索结果数

# 商业大模型基线测试 API
QWEN_API_KEY="your_qwen_api_key_here"
DOUBAO_API_KEY="your_doubao_api_key_here"
DOUBAO_ENDPOINT_ID="your_doubao_endpoint_id_here"
HUGGINGFACE_TOKEN="your_huggingface_token_here"

HTTP_PROXY=http://
HTTPS_PROXY=http://

# Cross-run source memory (new tasks only; existing tasks preserve original config)
MEMORY_ENABLED=1
MEMORY_NAMESPACE=workspace/default
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.65
MEMORY_TTL_DAYS=30
MEMORY_CHAR_BUDGET=3000

# Optional PostgreSQL backend (keep sqlite until initialized)
APEXLOGIC_STORAGE_BACKEND=sqlite
# APEXLOGIC_POSTGRES_DSN=host=127.0.0.1 port=5432 dbname=apexlogic user=apexlogic password=YOUR_PASSWORD
# APEXLOGIC_POSTGRES_PASSWORD=YOUR_PASSWORD

# Background worker: dedicated Redis Streams instance (not the evicting cache Redis)
# APEXLOGIC_QUEUE_REDIS_PASSWORD=YOUR_SEPARATE_QUEUE_PASSWORD
# APEXLOGIC_QUEUE_REDIS_PORT=6380
# APEXLOGIC_QUEUE_REDIS_URL=redis://:YOUR_SEPARATE_QUEUE_PASSWORD@127.0.0.1:6380/0
