# DeepSeek (OpenAI compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Tavily
TAVILY_API_KEY=your_tavily_api_key

# Search providers
SEARCH_QUERY_BUDGET=3
DDG_TOTAL_RESULTS=35
ARXIV_TOTAL_RESULTS=20
TAVILY_TOTAL_RESULTS=5
ARXIV_SYNONYM_FILE=

# BGE retrieval pipeline (OpenAI-compatible API)
BGE_RETRIEVER_ENABLED=1
BGE_RERANKER_ENABLED=1
BGE_RETRIEVER_TOP_K=20
BGE_RERANKER_TOP_K=10

# 推荐使用 SiliconFlow 等兼容 /v1/embeddings 与 /v1/rerank 的服务
# 也可替换为你自建网关，只需保持 OpenAI 兼容协议
BGE_EMBED_API_KEY=your_bge_api_key
BGE_EMBED_BASE_URL=https://api.siliconflow.cn/v1
BGE_EMBED_MODEL=BAAI/bge-m3
BGE_EMBED_TIMEOUT=20
BGE_EMBED_BATCH_SIZE=32

BGE_RERANK_API_KEY=your_bge_api_key
BGE_RERANK_BASE_URL=https://api.siliconflow.cn/v1
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_RERANK_TIMEOUT=25

# Runtime
MAX_REVISIONS=3